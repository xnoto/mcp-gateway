{
  "mcpServers": {
    "aws-staging": {
      "port": 8765,
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile",
        "staging",
        "--read-only",
        "--metadata",
        "AWS_REGION=us-east-2"
      ]
    },
    "aws-prod": {
      "port": 8766,
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile",
        "prod",
        "--read-only",
        "--metadata",
        "AWS_REGION=us-east-2"
      ]
    },
    "grafana": {
      "port": 8768,
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.config/mcp-gateway/bin/grafana\""
      ]
    },
    "agent-hub": {
      "port": 8776,
      "command": "npx",
      "args": [
        "-y",
        "agent-hub-mcp@0.4.0"
      ]
    },
    "tmux": {
      "port": 8770,
      "command": "npx",
      "args": [
        "-y",
        "tmux-mcp@0.2.2"
      ]
    },
    "opencode-docs": {
      "port": 8773,
      "command": "npx",
      "args": [
        "-y",
        "opencode-docs-mcp@1.0.0"
      ]
    },
    "argocd-staging-eks": {
      "port": 8774,
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.config/mcp-gateway/bin/argocd\" staging"
      ]
    },
    "argocd-prod-eks": {
      "port": 8775,
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/.config/mcp-gateway/bin/argocd\" prod"
      ]
    }
  }
}
